# TestForge Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git!

# ============================================
# Mode Selection
# ============================================
# Mode: mock (in-memory bot) or real (test Telegram account over MTProto, ADR-006)
TESTFORGE_MODE=mock

# ============================================
# LLM Provider (for LLM-as-judge)
# ============================================
# Anthropic API key (get from console.anthropic.com)
TESTFORGE_LLM_API_KEY=sk-ant-api03-...your-key-here...

# Alternative: OpenAI API key (not used in Phase 0)
# TESTFORGE_OPENAI_API_KEY=sk-...your-key-here...

# ============================================
# Telegram test account (for real mode only)
# ============================================
# A dedicated test account, not your personal one (ADR-006)
# api_id and api_hash: https://my.telegram.org
# TESTFORGE_TG_API_ID=123456
# TESTFORGE_TG_API_HASH=0123456789abcdef0123456789abcdef
# Session string: create once with `python scripts/telegram_login.py`. Keep it secret.
# TESTFORGE_TG_SESSION=1BVts...
# Username of the staging bot, with or without @
# TESTFORGE_TG_BOT=ask_toby_staging_bot

# ============================================
# Optional: Override defaults
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
# TESTFORGE_LOG_LEVEL=INFO

# Cost budget override (USD)
# TESTFORGE_MAX_COST_PER_RUN=0.50

# Timeout for LLM calls (seconds)
# TESTFORGE_LLM_TIMEOUT=30
