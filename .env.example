# TestForge Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git!

# ============================================
# Mode Selection
# ============================================
# Mode: mock (in-memory bot) or real (Telegram Bot API)
TESTFORGE_MODE=mock

# ============================================
# LLM Provider (for LLM-as-judge)
# ============================================
# Anthropic API key (get from console.anthropic.com)
TESTFORGE_LLM_API_KEY=sk-ant-api03-...your-key-here...

# Alternative: OpenAI API key (not used in Phase 0)
# TESTFORGE_OPENAI_API_KEY=sk-...your-key-here...

# ============================================
# Telegram Bot (for real mode only)
# ============================================
# ask-toby staging bot token (from @BotFather)
# Not needed for mock mode
# TESTFORGE_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz...

# Your Telegram user ID (get from @userinfobot)
# Not needed for mock mode
# TESTFORGE_TEST_USER_ID=123456789

# ============================================
# Optional: Override defaults
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
# TESTFORGE_LOG_LEVEL=INFO

# Cost budget override (USD)
# TESTFORGE_MAX_COST_PER_RUN=0.50

# Timeout for LLM calls (seconds)
# TESTFORGE_LLM_TIMEOUT=30
